# ─── Datenbank ────────────────────────────────────────────────────────────────
# DIESELBE Postgres-Instanz wie der Agent, kein zweites Deployment. Das Frontend
# liest nur; es fuehrt KEINE Migrationen aus und legt keine Tabelle an. Das
# Schema "app" gehoert dem Agent-Repo (src/db/schema.ts, Migrationen in drizzle/).
#
# Lokal: `docker compose up postgres -d`, dann diesen Wert.
DATABASE_URL=postgres://mastra:mastra@localhost:5432/mastra
#
# Auf Railway als Referenz-Variable auf den Postgres-Service, nicht als
# kopierter Connection String (Railway rotiert das Passwort):
#   DATABASE_URL=${{ Postgres.DATABASE_URL }}

# Maximale Verbindungen im eigenen Pool des Frontends. Default 3.
# Bewusst klein: eine kleine Railway-Postgres-Instanz erlaubt insgesamt rund 20
# Verbindungen, und davon nimmt der Agent schon 8 (DB_POOL_MAX). Die Oberflaeche
# liest nur und braucht nicht mehr.
# FRONTEND_DB_POOL_MAX=3

# ─── Agent-Service ────────────────────────────────────────────────────────────
# Nur fuer die Belegbilder: die liegen als Dateien im Datenverzeichnis des
# Agenten, nicht in Postgres. app.receipts.file_reference haelt bloss den Zeiger
# "local:uploads/<uploadId>". /api/belege/<id>/bild proxyt auf diesen Service.
#
# Serverseitig gelesen (kein NEXT_PUBLIC_*), die Adresse landet also nicht im
# Browser. Im Docker-Netz der Servicename, lokal http://localhost:4111.
# Auf Railway das Private Networking des Agent-Service:
#   MASTRA_URL=http://${{ mastra-agent.RAILWAY_PRIVATE_DOMAIN }}:4111
MASTRA_URL=http://localhost:4111
