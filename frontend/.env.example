# ─── Belegdienst (api/) ───────────────────────────────────────────────────────
# Diese Oberflaeche hat KEINE Datenbankverbindung. Alle Belegdaten kommen ueber
# den Dienst in api/ - Liste, Detail, Kennzahl, Export und die Korrektur von
# Kategorie und Belegart.
#
# Lokal: `docker compose up postgres api -d`, dann dieser Wert.
API_URL=http://localhost:4000
#
# Auf Railway das Private Networking des API-Service:
#   API_URL=http://${{ receipt-api.RAILWAY_PRIVATE_DOMAIN }}:4000

# Das gemeinsame Geheimnis mit dem Dienst - DERSELBE Wert wie dort und beim
# Agenten. Mindestens 32 Zeichen; der Dienst weist einen kuerzeren beim Start ab.
#
# Damit darf dieser Prozess im Namen jedes Nutzers arbeiten. Deshalb schickt der
# API-Client als Subject ausschliesslich die Entra-oid aus der SESSION
# (X-Subject-Aad) und niemals einen Wert aus einem Browser-Request - siehe
# lib/api/client.ts.
API_SERVICE_TOKEN=

# Zeitlimit fuer einen Aufruf an den Dienst, in Millisekunden. Default 15000.
# API_TIMEOUT_MS=15000

# ─── Anmeldung (Microsoft Entra ID) ───────────────────────────────────────────
# App-Registrierung im Tenant, Typ Web. Redirect-URI:
#   https://<oeffentliche-url>/api/auth/callback/microsoft-entra-id
#   http://localhost:3000/api/auth/callback/microsoft-entra-id   (lokal)
#
# Delegierte Berechtigungen: openid, profile, email. Mehr braucht es nicht -
# diese Oberflaeche ruft keine Graph-API und braucht KEIN Zugriffstoken fuer den
# Belegdienst (der vertraut dem Service-Token oben).
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Mit Tenant-ID, nicht /common: sonst kann sich jedes Microsoft-Konto anmelden.
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# Schluessel, mit dem das Session-Cookie verschluesselt wird.
# Erzeugen: openssl rand -base64 32
AUTH_SECRET=

# Die oeffentliche URL dieser Anwendung. Braucht es, sobald ein Proxy davor
# steht (Railway): sonst baut Auth.js die Redirect-URI aus dem internen Host.
# Lokal kann es leer bleiben.
# AUTH_URL=https://<oeffentliche-url>

# ─── Agent-Service ────────────────────────────────────────────────────────────
# Nur fuer die Belegbilder: die liegen als Dateien im Datenverzeichnis des
# Agenten, nicht in Postgres und nicht beim Belegdienst.
# receipts.file_reference haelt bloss den Zeiger "local:uploads/<uploadId>".
# /api/receipts/<id>/image proxyt auf diesen Service, nachdem der Belegdienst
# bestaetigt hat, dass der Beleg dem angemeldeten Nutzer gehoert.
#
# Serverseitig gelesen (kein NEXT_PUBLIC_*), die Adresse landet also nicht im
# Browser. Im Docker-Netz der Servicename, lokal http://localhost:4111.
# Auf Railway das Private Networking des Agent-Service:
#   MASTRA_URL=http://${{ mastra-agent.RAILWAY_PRIVATE_DOMAIN }}:4111
MASTRA_URL=http://localhost:4111

# ─── Optional ─────────────────────────────────────────────────────────────────
# Deep Link in den Teams-Chat mit dem Spesen-Bot. Ist er nicht gesetzt, ist der
# Knopf "Capture in Teams" deaktiviert - besser als eine geratene URL.
# Form: https://teams.microsoft.com/l/chat/0/0?users=28:<bot-app-id>
# TEAMS_CHAT_URL=
