{
  "name": "mastra-teamsbot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "api"
  ],
  "exports": {
    "./db/schema": "./src/db/schema.ts",
    "./db/receipts": "./src/db/receipts.ts",
    "./db/settlements": "./src/db/settlements.ts",
    "./db/users": "./src/db/users.ts",
    "./db/pool": "./src/db/pool.ts",
    "./db": "./src/db/index.ts",
    "./receipts/candidate": "./src/mastra/receipts/candidate.ts",
    "./receipts/no-receipt": "./src/mastra/receipts/no-receipt.ts"
  },
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build --studio",
    "start": "mastra start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:deploy": "node scripts/migrate.mjs",
    "db:prune": "node scripts/prune.mjs",
    "db:studio": "drizzle-kit studio",
    "teams:manifest": "node teams-app/build.mjs"
  },
  "dependencies": {
    "@chat-adapter/teams": "^4.39.0",
    "@mastra/ai-sdk": "^1.10.0",
    "@mastra/core": "^1.63.2",
    "@mastra/memory": "^1.28.1",
    "@mastra/pg": "^1.22.3",
    "bmp-js": "^0.1.0",
    "chat": "^4.39.0",
    "drizzle-orm": "^0.45.2",
    "heic-decode": "^2.1.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "mastra": "^1.27.2",
    "railway": "^3.11.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
