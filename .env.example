# ─── Modell ────────────────────────────────────────────────────────────────────
# Format <provider>/<model>. Muss vision-fähig sein: Belege sind Bilder.
# Beispiele: openai/gpt-4o-mini · anthropic/claude-sonnet-4-5
MASTRA_MODEL=openrouter/anthropic/claude-sonnet-4.5

# Key des Providers, der in MASTRA_MODEL steht. Nur einer davon wird gebraucht.
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ─── Microsoft Teams (Azure Bot Registration) ─────────────────────────────────
# Alle drei liest @chat-adapter/teams selbst aus der Umgebung.
# TEAMS_APP_TENANT_ID ist PFLICHT, weil der Adapter mit appType "SingleTenant"
# konfiguriert ist (src/mastra/agents/teams-agent.ts).
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
TEAMS_APP_TENANT_ID=

# ─── Server ───────────────────────────────────────────────────────────────────
# PORT setzt Railway selbst. Lokal ist 4111 der Default.
# PORT=4111
MASTRA_HOST=0.0.0.0

# Origin des Belegerfassungs-Frontends, für die CORS-Freigabe des Mastra-Servers.
# Nur nötig, wenn der Browser Mastra direkt aufruft (README, Variante B).
# Mehrere Origins mit Komma trennen. Für den Teams-Bot irrelevant.
FRONTEND_ORIGIN=http://localhost:3000

# ─── Persistenz ───────────────────────────────────────────────────────────────
# LibSQL-Store für Threads, Messages, Working Memory und Traces.
# Default ist eine Datei unter /app/data – die ist auf Railway OHNE Volume nach
# jedem Redeploy weg. Für dauerhafte Threads entweder ein Railway-Volume auf
# /app/data mounten oder hier eine Turso-URL eintragen:
#   DATABASE_URL=libsql://<db>-<org>.turso.io
#   DATABASE_AUTH_TOKEN=<turso token>
# DATABASE_URL=file:/app/data/mastra.db

# Datenverzeichnis für Uploads und die erzeugten JSON-Dateien.
# Gleiche Volume-Überlegung wie bei DATABASE_URL.
# RECEIPT_DATA_DIR=/app/data

# ─── Sonstiges ────────────────────────────────────────────────────────────────
# Anonyme Telemetrie deaktivieren (optional)
MASTRA_TELEMETRY_DISABLED=1
