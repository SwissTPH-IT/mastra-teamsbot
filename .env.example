# ─── Modell ────────────────────────────────────────────────────────────────────
# Format <provider>/<model>. Muss vision-fähig sein: Belege sind Bilder.
# Beispiele: openai/gpt-4o-mini · anthropic/claude-sonnet-4-5
MASTRA_MODEL=openrouter/anthropic/claude-sonnet-4.5

# Key des Providers, der in MASTRA_MODEL steht. Nur einer davon wird gebraucht.
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ─── Microsoft Teams (Azure Bot Registration) ─────────────────────────────────
# Alle drei liest @chat-adapter/teams selbst aus der Umgebung.
# TEAMS_APP_TENANT_ID ist PFLICHT, weil der Adapter mit appType "SingleTenant"
# konfiguriert ist (src/mastra/agents/teams-agent.ts).
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
TEAMS_APP_TENANT_ID=

# ─── Server ───────────────────────────────────────────────────────────────────
# PORT setzt Railway selbst. Lokal ist 4111 der Default.
# PORT=4111
MASTRA_HOST=0.0.0.0

# Origin des Belegerfassungs-Frontends, für die CORS-Freigabe des Mastra-Servers.
# Nur nötig, wenn der Browser Mastra direkt aufruft (README, Variante B).
# Mehrere Origins mit Komma trennen. Für den Teams-Bot irrelevant.
FRONTEND_ORIGIN=http://localhost:3000

# ─── Persistenz: Postgres ─────────────────────────────────────────────────────
# EINE Instanz, ZWEI Schemas, EIN Connection String:
#   Schema "mastra" – von PostgresStore verwaltet (Threads, Messages, Traces und
#                     vor allem mastra_workflow_snapshot, wo ein suspendierter
#                     Review-Run auf die Antwort des Nutzers wartet)
#   Schema "app"    – unsere Fachdaten (app.receipts, app.pending_reviews),
#                     migriert über Drizzle
#
# Lokal: `docker compose up postgres -d`, dann diesen Wert übernehmen.
DATABASE_URL=postgres://mastra:mastra@localhost:5432/mastra
#
# Auf Railway NICHT von Hand eintragen, sondern als Referenz-Variable auf den
# Postgres-Service zeigen lassen:
#   DATABASE_URL=${{ Postgres.DATABASE_URL }}

# Maximale Verbindungen im gemeinsamen Pool (PostgresStore + Drizzle teilen ihn).
# Default 8. PostgresStore allein würde bis zu 20 öffnen – zu viel für eine
# kleine Railway-Instanz, auf der auch Migrations-Job und später das Frontend
# Verbindungen brauchen.
# DB_POOL_MAX=8

# Datenverzeichnis für die hochgeladenen Belegbilder. Die Originaldateien liegen
# NICHT in der Datenbank, dort steht nur die Referenz (file_reference). Auf
# Railway gehört hierauf ein Volume, sonst sind die Bilder nach jedem Redeploy
# weg. Siehe README, "Offene Lücke: Objektspeicher".
# RECEIPT_DATA_DIR=/app/data

# ─── Human-in-the-Loop ────────────────────────────────────────────────────────
# Wie oft der Nutzer korrigieren darf, bevor der Workflow ohne Speichern
# abbricht. Nach jeder Korrektur wird erneut vorgelegt. Default 3.
# RECEIPT_MAX_CORRECTION_ROUNDS=3

# ─── Retention (nur für den Prune-Job, scripts/prune.mjs) ─────────────────────
# Die Span-Tabellen wachsen um Grössenordnungen schneller als die Belege.
# app.receipts hat bewusst keine Retention – Belege bleiben.
# RETENTION_SPANS=14d
# RETENTION_SNAPSHOTS=30d
# RETENTION_MESSAGES=180d

# ─── Tests ────────────────────────────────────────────────────────────────────
# Der Suspend/Resume-Test läuft gegen eine echte Postgres. Ohne diese Variable
# wird er übersprungen statt rot.
# TEST_DATABASE_URL=postgres://mastra:mastra@localhost:5432/mastra

# ─── Sonstiges ────────────────────────────────────────────────────────────────
# Anonyme Telemetrie deaktivieren (optional)
MASTRA_TELEMETRY_DISABLED=1
