   "y": 2124,
   "width": 570,
   "height": 146,
   "text": "service(\"receipt-frontend\", {\n  build: { dockerfilePath: \"frontend/Dockerfile\" },\n  deploy: { healthcheckPath: \"/api/healthz\" },\n  env: {\n    API_URL: `http://${{receipt-api.RAILWAY_PRIVATE_DOMAIN}}:4000`,\n    API_SERVICE_TOKEN: preserve(),  // Secret, nie im Repo\n    AUTH_MICROSOFT_ENTRA_ID_SECRET: preserve(),\n  },\n})",
